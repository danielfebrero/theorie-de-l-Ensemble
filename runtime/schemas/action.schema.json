{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielfebrero/theorie-de-l-Ensemble/runtime/schemas/action.schema.json",
  "title": "M3C3 LTS action",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "actor", "layer_src", "layer_dst", "payload", "ruin", "irreversible"],
  "properties": {
    "kind": {"enum": ["project", "transition_up", "read_down", "write_local", "allocate", "export", "resolve", "recover", "kill", "activate_scope", "deactivate_scope"]},
    "actor": {"type": "string", "minLength": 1},
    "layer_src": {"anyOf": [{"enum": ["binary", "forces", "math", "conscious_sets", "programs", "life_game_M1C1"]}, {"type": "null"}]},
    "layer_dst": {"anyOf": [{"enum": ["binary", "forces", "math", "conscious_sets", "programs", "life_game_M1C1"]}, {"type": "null"}]},
    "payload": {"type": "object"},
    "token": {"type": ["string", "null"]},
    "token_present": {"type": "boolean"},
    "ruin": {"type": "boolean"},
    "irreversible": {"type": "boolean"}
  }
}
