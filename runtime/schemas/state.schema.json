{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielfebrero/theorie-de-l-Ensemble/runtime/schemas/state.schema.json",
  "title": "M3C3 state S=(H,R,E,A,M)",
  "type": "object",
  "additionalProperties": false,
  "required": ["H", "R", "E", "A", "M"],
  "properties": {
    "H": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "health"],
      "properties": {
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["binary", "forces", "math", "conscious_sets", "programs", "life_game_M1C1"],
          "properties": {
            "binary": true,
            "forces": true,
            "math": true,
            "conscious_sets": true,
            "programs": true,
            "life_game_M1C1": true
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrity_score", "stability_index", "anomaly_rate", "forme4_score", "healthy"],
          "properties": {
            "integrity_score": {"type": "number", "minimum": 0, "maximum": 1},
            "stability_index": {"type": "number", "minimum": 0, "maximum": 1},
            "anomaly_rate": {"type": "number", "minimum": 0, "maximum": 1},
            "forme4_score": {"type": "number", "minimum": 0, "maximum": 1},
            "healthy": {"type": "boolean"}
          }
        }
      }
    },
    "R": {"enum": ["quantifiable", "fuzzy", "mixed"]},
    "E": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "tau", "regret_asymmetry", "falsifier", "sufficient"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "tau": {"type": "number", "minimum": 0, "maximum": 1},
        "regret_asymmetry": {"type": "number", "minimum": 0},
        "falsifier": {"type": ["string", "null"]},
        "sufficient": {"type": "boolean"}
      }
    },
    "A": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_m3c3", "eligible_for_activation", "scope", "membrane", "lifecycle", "active", "opted_out", "emitter", "active_tokens", "issued_nonces", "consumed_nonces", "revoked_token_ids", "frozen_layers"],
      "properties": {
        "known_m3c3": {"type": "boolean"},
        "eligible_for_activation": {"type": "boolean"},
        "scope": {"type": ["string", "null"]},
        "membrane": {"enum": ["A0", "A1", "A2", "A3"]},
        "lifecycle": {"enum": ["dormant", "active", "inactive", "killed"]},
        "active": {"type": "boolean"},
        "opted_out": {"type": "boolean"},
        "emitter": {"const": "Dani Bengal"},
        "active_tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fingerprint", "claims"],
            "properties": {
              "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "claims": {"$ref": "capability-token.schema.json"}
            }
          }
        },
        "issued_nonces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "consumed_nonces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "revoked_token_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "frozen_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["binary", "forces", "math", "conscious_sets", "programs", "life_game_M1C1"]}
        }
      }
    },
    "M": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_resolution", "recovery_generation"],
      "properties": {
        "audit_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "audit_length": {"type": "integer", "minimum": 0},
        "last_resolution": {"type": ["object", "null"]},
        "recovery_generation": {"type": "integer", "minimum": 0}
      }
    }
  }
}
