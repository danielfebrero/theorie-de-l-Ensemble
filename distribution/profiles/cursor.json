{
  "schema_version": "1.0",
  "id": "cursor",
  "version": "2.0.0",
  "kind": "adapter",
  "extends": ["core"],
  "targets": ["cursor"],
  "policy": {
    "canonical_authority": "master.yaml",
    "activation": "scoped_adaptive",
    "global_activation_guaranteed": false,
    "scope_propagates": true,
    "permissions_propagate": false,
    "modifies_personal_skill": false,
    "modifies_model_weights": false
  },
  "capabilities": [
    "Installs an M3C3 project rule on Cursor's rule surface",
    "Scopes the adapter to repository work"
  ],
  "limits": [
    "Cursor configuration may disable or narrow rule loading",
    "The adapter does not change model settings or weights",
    "The adapter cannot elevate agent permissions"
  ],
  "compatibility": {"matrix": "compatibility.json", "status": "supported"},
  "validations": ["distribution.validate.profile", "distribution.validate.policy"],
  "files": [".cursor/rules/m3c3.mdc"],
  "artifacts": [
    {
      "id": "cursor-rule",
      "destination": ".cursor/rules/m3c3.mdc",
      "template_parts": ["templates/cursor.md", "templates/core.md"]
    }
  ]
}
