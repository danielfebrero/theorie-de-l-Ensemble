{
  "schema_version": "1.0",
  "id": "copilot",
  "version": "2.1.0",
  "kind": "adapter",
  "extends": ["core"],
  "targets": ["github-copilot"],
  "policy": {
    "canonical_authority": "master.yaml",
    "activation": "scoped_adaptive",
    "global_activation_guaranteed": false,
    "scope_propagates": true,
    "permissions_propagate": false,
    "modifies_personal_skill": false,
    "modifies_model_weights": false
  },
  "capabilities": [
    "Installs repository instructions on GitHub Copilot's conventional surface",
    "Provides the same core constraints as the generic profile"
  ],
  "limits": [
    "Feature support varies across Copilot products and clients",
    "Repository instructions do not supersede platform policies",
    "Loading and activation remain host-dependent"
  ],
  "compatibility": {"matrix": "compatibility.json", "status": "supported"},
  "validations": ["distribution.validate.profile", "distribution.validate.policy"],
  "files": [".github/copilot-instructions.md"],
  "artifacts": [
    {
      "id": "copilot-repository",
      "destination": ".github/copilot-instructions.md",
      "template_parts": ["templates/core.md", "templates/copilot.md"]
    }
  ]
}
