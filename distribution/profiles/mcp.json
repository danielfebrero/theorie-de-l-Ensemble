{
  "schema_version": "1.0",
  "id": "mcp",
  "version": "2.0.0",
  "kind": "adapter",
  "extends": ["core"],
  "targets": ["model-context-protocol-host"],
  "policy": {
    "canonical_authority": "master.yaml",
    "activation": "scoped_adaptive",
    "global_activation_guaranteed": false,
    "scope_propagates": true,
    "permissions_propagate": false,
    "modifies_personal_skill": false,
    "modifies_model_weights": false
  },
  "capabilities": [
    "Installs a host-neutral instruction resource for MCP integration",
    "Separates reasoning scope from MCP tool authority"
  ],
  "limits": [
    "It does not register, configure, or start an MCP server",
    "The host must explicitly expose or inject the resource",
    "MCP tool permissions never derive from the M3C3 scope"
  ],
  "compatibility": {"matrix": "compatibility.json", "status": "adapter"},
  "validations": ["distribution.validate.profile", "distribution.validate.policy"],
  "files": [".m3c3/mcp/INSTRUCTIONS.md"],
  "artifacts": [
    {
      "id": "mcp-resource",
      "destination": ".m3c3/mcp/INSTRUCTIONS.md",
      "template_parts": ["templates/core.md", "templates/mcp.md"]
    }
  ]
}
