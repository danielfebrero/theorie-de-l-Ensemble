{
  "schema_version": "1.0",
  "id": "ci",
  "version": "2.1.0",
  "kind": "adapter",
  "extends": ["core"],
  "targets": ["ci-agent", "review-bot"],
  "policy": {
    "canonical_authority": "master.yaml",
    "activation": "scoped_adaptive",
    "global_activation_guaranteed": false,
    "scope_propagates": true,
    "permissions_propagate": false,
    "modifies_personal_skill": false,
    "modifies_model_weights": false
  },
  "capabilities": [
    "Installs a deterministic instruction resource for CI agents and review bots",
    "Requires evidence-backed conformance claims"
  ],
  "limits": [
    "The workflow must explicitly load the resource",
    "Passing CI proves only the checks that actually ran",
    "The profile grants no repository write or deployment authority"
  ],
  "compatibility": {"matrix": "compatibility.json", "status": "adapter"},
  "validations": ["distribution.validate.profile", "distribution.validate.policy"],
  "files": [".m3c3/ci/INSTRUCTIONS.md"],
  "artifacts": [
    {
      "id": "ci-resource",
      "destination": ".m3c3/ci/INSTRUCTIONS.md",
      "template_parts": ["templates/core.md", "templates/ci.md"]
    }
  ]
}
