{
  "schema_version": "1.0",
  "id": "claude",
  "version": "2.0.0",
  "kind": "adapter",
  "extends": ["core"],
  "targets": ["claude-code"],
  "policy": {
    "canonical_authority": "master.yaml",
    "activation": "scoped_adaptive",
    "global_activation_guaranteed": false,
    "scope_propagates": true,
    "permissions_propagate": false,
    "modifies_personal_skill": false,
    "modifies_model_weights": false
  },
  "capabilities": [
    "Installs a project-scoped CLAUDE.md adapter",
    "Makes the portable kernel available when Claude Code loads project instructions"
  ],
  "limits": [
    "Does not override Claude Code policy or user configuration",
    "Does not imply activation in unrelated conversations or projects",
    "Does not grant tools or permissions"
  ],
  "compatibility": {"matrix": "compatibility.json", "status": "supported"},
  "validations": ["distribution.validate.profile", "distribution.validate.policy"],
  "files": ["CLAUDE.md"],
  "artifacts": [
    {
      "id": "claude-project",
      "destination": "CLAUDE.md",
      "template_parts": ["templates/core.md", "templates/claude.md"]
    }
  ]
}
