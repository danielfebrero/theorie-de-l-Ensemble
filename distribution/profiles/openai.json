{
  "schema_version": "1.0",
  "id": "openai",
  "version": "2.1.0",
  "kind": "adapter",
  "extends": ["core"],
  "targets": ["openai-codex", "agents-md"],
  "policy": {
    "canonical_authority": "master.yaml",
    "activation": "scoped_adaptive",
    "global_activation_guaranteed": false,
    "scope_propagates": true,
    "permissions_propagate": false,
    "modifies_personal_skill": false,
    "modifies_model_weights": false
  },
  "capabilities": [
    "Installs a repository-scoped AGENTS.md adapter",
    "Propagates the reasoning scope to delegated agents when their host loads AGENTS.md"
  ],
  "limits": [
    "Does not override higher-priority OpenAI or repository instructions",
    "Does not install or edit a personal Codex skill",
    "Cannot guarantee that every OpenAI surface discovers AGENTS.md"
  ],
  "compatibility": {"matrix": "compatibility.json", "status": "supported"},
  "validations": ["distribution.validate.profile", "distribution.validate.policy"],
  "files": ["AGENTS.md"],
  "artifacts": [
    {
      "id": "openai-agents",
      "destination": "AGENTS.md",
      "template_parts": ["templates/core.md", "templates/openai.md"]
    }
  ]
}
