{
  "schema_version": "1.0",
  "id": "all",
  "version": "2.0.0",
  "kind": "aggregate",
  "extends": [],
  "includes": ["core", "openai", "claude", "copilot", "cursor", "mcp", "ci"],
  "targets": ["multi-agent-repository"],
  "policy": {
    "canonical_authority": "master.yaml",
    "activation": "scoped_adaptive",
    "global_activation_guaranteed": false,
    "scope_propagates": true,
    "permissions_propagate": false,
    "modifies_personal_skill": false,
    "modifies_model_weights": false
  },
  "capabilities": [
    "Resolves every declared REACH-MAX v2 adapter in one operation",
    "Produces a manifest covering all installed instruction surfaces"
  ],
  "limits": [
    "Installation does not mean that every host loads its surface",
    "No adapter grants permissions or global activation",
    "Existing files are never overwritten without explicit --force"
  ],
  "compatibility": {"matrix": "compatibility.json", "status": "aggregate"},
  "validations": ["distribution.validate.profile", "distribution.validate.aggregate", "distribution.tests.all"],
  "files": [
    ".m3c3/M3C3.md",
    "AGENTS.md",
    "CLAUDE.md",
    ".github/copilot-instructions.md",
    ".cursor/rules/m3c3.mdc",
    ".m3c3/mcp/INSTRUCTIONS.md",
    ".m3c3/ci/INSTRUCTIONS.md"
  ],
  "artifacts": []
}
